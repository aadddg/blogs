---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import UmamiStats from "../components/UmamiStats.svelte";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

// 读取所有友链JSON文件
const friendFiles = import.meta.glob("../content/friends/*.json", { eager: true });

interface Friend {
  name: string;
  url: string;
  avatar?: string;
  description?: string;
  tags?: string[];
}

const friends: Friend[] = Object.values(friendFiles).map((file: any) => ({
  name: file.name,
  url: file.url,
  avatar: file.avatar,
  description: file.description,
  tags: file.tags,
}));
---
<MainGridLayout title={i18n(I18nKey.friends)} description={i18n(I18nKey.friends)}>
    <div class="flex w-full rounded-[10px] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <div class="flex items-center justify-between mb-6">
                <h1 class="text-2xl font-bold text-90">{i18n(I18nKey.friends)}</h1>
                <UmamiStats path="/friends/" client:only="svelte" />
            </div>
            
            {friends.length === 0 ? (
                <div class="text-center py-12 text-50">
                    <p>{i18n(I18nKey.noFriends)}</p>
                </div>
            ) : (
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    {friends.map((friend) => (
                        <a 
                            href={friend.url} 
                            target="_blank" 
                            rel="noopener noreferrer"
                            class="group flex items-start gap-4 p-4 rounded-[10px] bg-[var(--card-bg)] hover:bg-[var(--card-bg-hover)] transition-all duration-300 border border-[var(--line-divider)] hover:border-[var(--primary)]"
                        >
                            {friend.avatar && (
                                <div class="flex-shrink-0">
                                    <img 
                                        src={friend.avatar} 
                                        alt={friend.name}
                                        class="w-14 h-14 rounded-full object-cover border-2 border-[var(--line-divider)] group-hover:border-[var(--primary)] transition-colors"
                                        loading="lazy"
                                    />
                                </div>
                            )}
                            <div class="flex-1 min-w-0">
                                <h3 class="font-semibold text-lg text-90 truncate group-hover:text-[var(--primary)] transition-colors">
                                    {friend.name}
                                </h3>
                                {friend.description && (
                                    <p class="text-sm text-50 mt-1 line-clamp-2">
                                        {friend.description}
                                    </p>
                                )}
                                {friend.tags && friend.tags.length > 0 && (
                                    <div class="flex flex-wrap gap-1 mt-2">
                                        {friend.tags.map((tag) => (
                                            <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">
                                                {tag}
                                            </span>
                                        ))}
                                    </div>
                                )}
                            </div>
                        </a>
                    ))}
                </div>
            )}
        </div>
    </div>
</MainGridLayout>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>