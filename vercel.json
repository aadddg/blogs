{
	"buildCommand": "npm run build",
	"outputDirectory": "dist",
	"framework": "astro",
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": "/index.html"
		}
	],
	"headers": [
		{
			"source": "/_astro/(.*)",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/javascript"
				}
			]
		}
	]
}